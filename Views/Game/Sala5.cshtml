@{
    ViewBag.Title = "Sala 5";
}

<div class="game-room" id="gameRoom" data-room="5">

    <img class="room-background"
         src="~/images/salas/sala5.png"
         alt="Enfermería abandonada">

    <button class="game-button"
            onclick="room5Nota()"
            style="left: 55%; top: 57%;">
        Nota
    </button>

    <button class="game-button"
            onclick="room5USB()"
            style="left: 61%; top: 63%;">
        USB
    </button>

    <button class="game-button"
            onclick="room5Computadora()"
            style="left: 52%; top: 43%;">
        Computadora
    </button>

</div>

<div id="gameModal" class="game-modal hidden">
    <div class="game-modal-content">
        <button class="close-modal" onclick="cerrarModal()">X</button>
        <div id="modalContent"></div>
    </div>
</div>

<div id="notification" class="game-notification"></div>