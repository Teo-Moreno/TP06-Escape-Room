@{
    ViewData["Title"] = "Habitación 5";
    int idPartida = ViewBag.IdPartida != null ? (int)ViewBag.IdPartida : 0;
}

<div class="asylum-room" data-room="5" data-partida="@idPartida">
    <div class="asylum-stage">

        <section id="s5-stairs" class="asylum-scene active scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 23.png" alt="Escaleras al sótano" />
            <div class="scene-caption">Jon baja las escaleras.</div>
            <button class="hotspot position-center" type="button" onclick="s5Basement()">BAJAR</button>
        </section>

        <section id="s5-basement" class="asylum-scene scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 24.png" alt="Sótano abandonado" />
            <div class="scene-caption">Al fondo hay algo que parece una silueta.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s5ContinueBasement()">AVANZAR</button>
        </section>

        <section id="s5-box" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 25.png" alt="Caja en el sótano" />
            <button class="hotspot position-center" type="button" onclick="s5OpenBox()">CAJA</button>
        </section>

        <section id="s5-box-open" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 26.png" alt="Caja abierta" />
            <div class="scene-caption">La llave encaja.</div>
            <button class="hotspot position-center" type="button" onclick="s5Note()">ABRIR</button>
        </section>

        <section id="s5-note" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 27.png" alt="Nota encontrada" />
            <div class="scene-caption">Una nota. El mensaje no parece estar dirigido a cualquiera.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s5LeaveNote()">CONTINUAR</button>
        </section>

        <section id="s5-woman" class="asylum-scene scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 28.png" alt="Silueta de una mujer" />
            <div class="scene-caption">Un ruido. Jon se da vuelta.</div>
            <button class="hotspot position-center" type="button" onclick="s5WomanTalk()">MIRAR</button>
        </section>

        <section id="s5-shot" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 29.png" alt="Después del disparo" />
        </section>

        <section id="s5-awake" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 30.png" alt="Sala blanca del manicomio" />
            <div class="scene-caption">Jon despierta en una habitación blanca.</div>
            <button class="hotspot position-center" type="button" onclick="s5AwakeText()">¿QUÉ PASÓ?</button>
        </section>

        <section id="s5-news" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 31.png" alt="Noticia en la televisión" />
            <div class="scene-caption">La televisión muestra la verdad que Jon había olvidado.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s5Final()">MIRAR A JON</button>
        </section>

        <section id="s5-final" class="asylum-scene scene-dark scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/habitacion 5/foto 32.png" alt="Rostro aterrorizado de Jon" />
            <div class="scene-caption">
                <strong>FIN</strong>
                Jon recuerda.
            </div>
            <button class="hotspot position-bottom-right" type="button" onclick="s5Finish()">TERMINAR</button>
        </section>

    </div>
</div>

@await Html.PartialAsync("_Overlays")

<script>
    async function s5Basement() {
        await Asylum.markScene("sala5_escaleras");
        Asylum.showScene("s5-basement");
    }

    async function s5ContinueBasement() {
        await Asylum.markScene("sala5_sotano");
        Asylum.showScene("s5-box");
    }

    function s5OpenBox() {
        Asylum.showBlackScreen("La caja tiene una cerradura. Necesito usar la llave que encontré.", "Escribe ABRIR para usar la llave", async function (value, error) {
            if (value.toUpperCase() !== "ABRIR") {
                error("La llave no se utiliza así.");
                return;
            }

            const llave = await Asylum.loadProgress("llave_sotano");
            if (llave !== "1") {
                error("No tienes la llave.");
                return;
            }

            await Asylum.saveProgress("caja_abierta", "1");
            Asylum.closeBlackScreen();
            Asylum.showScene("s5-box-open");
        });
    }

    async function s5Note() {
        await Asylum.markScene("sala5_nota");
        Asylum.showScene("s5-note");
    }

    async function s5LeaveNote() {
        await Asylum.markScene("sala5_deja_nota");
        Asylum.flashBlack(1200);
        setTimeout(function () {
            Asylum.showScene("s5-woman");
        }, 1200);
    }

    async function s5WomanTalk() {
        await Asylum.markScene("sala5_mujer");
        Asylum.showText("No... por favor. No me dispares.", function () {
            Asylum.playNoise(.8, .13);
            Asylum.flashBlack(700);
            setTimeout(function () {
                Asylum.showScene("s5-shot");
                setTimeout(function () {
                    Asylum.showScene("s5-awake");
                }, 1500);
            }, 700);
        });
    }

    async function s5AwakeText() {
        await Asylum.markScene("sala5_despertar");
        Asylum.showText("¿Qué hago acá? ¿Dónde estoy? ¿Qué pasó con Marylin?", function () {
            Asylum.showScene("s5-news");
        });
    }

    async function s5Final() {
        await Asylum.markScene("sala5_noticia");
        Asylum.showText("La noticia muestra la verdad sobre Marylin. Jon había reconstruido los recuerdos de otra manera.", function () {
            Asylum.showScene("s5-final");
        });
    }

    async function s5Finish() {
        await Asylum.markScene("sala5_final");

        const body = new URLSearchParams();
        body.append("idPartida", Asylum.state.partida.toString());

        try {
            await fetch("/Game/CompletarPartida", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: body
            });
        } catch (error) {
            console.error("No se pudo finalizar la partida.", error);
        }

        window.location.href = "/Game/Saved";
    }
</script>
