@{
    ViewData["Title"] = "Inventario";
}

<div class="inventory-container">

    <h1>INVENTARIO</h1>

    <div class="inventory-grid">

        @foreach (var objeto in ViewBag.Objetos)
        {
            <div class="inventory-item">

                <img src="~/images/objetos/@objeto.Imagen" alt="@objeto.Nombre" />

                <h3>@objeto.Nombre</h3>

                <p>@objeto.Descripcion</p>

            </div>
        }

    </div>

</div>