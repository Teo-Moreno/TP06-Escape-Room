@{
    ViewBag.Title = "Sala 6";
}

<div class="game-room" id="gameRoom" data-room="6">

    <img class="room-background"
         src="../../wwwroot/images/salas/sala6.png"
         alt="Sala de archivos">

    <button class="game-button"
            onclick="room6Archivo(1)"
            style="left: 25%; top: 35%;">
        Archivo
    </button>

    <button class="game-button"
            onclick="room6Archivo(2)"
            style="left: 37%; top: 48%;">
        Archivo
    </button>

    <button class="game-button"
            onclick="room6Archivo(3)"
            style="left: 45%; top: 62%;">
        Archivo
    </button>

    <button class="game-button"
            onclick="room6Herramienta()"
            style="left: 84%; top: 65%;">
        Herramienta
    </button>

    <button class="game-button"
            onclick="room6Paciente()"
            style="left: 15%; top: 70%;">
        Examinar
    </button>

    <button class="game-button"
            onclick="room6Puerta()"
            style="left: 55%; top: 28%;">
        Puerta
    </button>

</div>

<div id="gameModal" class="game-modal hidden">
    <div class="game-modal-content">
        <button class="close-modal" onclick="cerrarModal()">X</button>
        <div id="modalContent"></div>
    </div>
</div>

<div id="notification" class="game-notification"></div>