@{
    ViewBag.Title = "Sala 1";
}

<div class="game-room" id="gameRoom" data-room="1">

    <img class="room-background"
         src="../../wwwroot/images/salas/sala1.png"
         alt="Exterior del Blackwood Psychiatric Hospital">

    <button class="game-button"
            id="btnPista"
            onclick="room1Pista()"
            style="left: 30%; top: 65%;">
        Examinar
    </button>

    <button class="game-button"
            id="btnPuerta"
            onclick="room1Puerta()"
            style="left: 52%; top: 53%;">
        Puerta
    </button>

</div>

<div id="gameModal" class="game-modal hidden">
    <div class="game-modal-content">
        <button class="close-modal" onclick="cerrarModal()">X</button>
        <div id="modalContent"></div>
    </div>
</div>

<div id="notification" class="game-notification"></div>