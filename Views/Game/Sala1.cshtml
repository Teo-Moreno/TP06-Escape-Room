@{
    ViewData["Title"] = "Habitación 1";
    int idPartida = ViewBag.IdPartida != null ? (int)ViewBag.IdPartida : 0;
}

<div class="asylum-room" data-room="1" data-partida="@idPartida">
    <div class="asylum-stage">

        <section id="s1-sign" class="asylum-scene active scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 1/1.png" alt="Cartel Blackwood Psychiatric Hospital" />
            <div class="scene-caption">
                <strong>BLACKWOOD PSYCHIATRIC HOSPITAL</strong>
                Trece años después, Jon vuelve al lugar donde cree que desapareció Marylin.
            </div>
            <button class="hotspot position-center" type="button" onclick="s1Start()">LLEGUE</button>
        </section>

        <section id="s1-exterior" class="asylum-scene scene-dark scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 1/2.png" alt="Exterior del hospital" />
            <div class="scene-caption">
                <strong>BLACKWOOD</strong>
                "Trece años... y sigue exactamente igual."
            </div>
            <button class="hotspot position-bottom-right" type="button" onclick="s1Approach()">ACERCARME</button>
        </section>

        <section id="s1-code" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 1/3.png" alt="Nota con el código" />
            <div class="scene-caption">Un código está oculto en una nota junto a la entrada.</div>
            <button class="hotspot position-center" type="button" onclick="s1EnterCode()">MIRAR CÓDIGO</button>
        </section>

        <section id="s1-door" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 1/4.png" alt="Puerta principal del hospital" />
            <div class="scene-caption">La puerta se abre.</div>
            <button class="hotspot position-center" type="button" onclick="s1Enter()">ENTRAR</button>
        </section>

    </div>
</div>

@await Html.PartialAsync("_Overlays")

<script>
    async function s1Start() {
        await Asylum.markScene("sala1_inicio");
        Asylum.showText("Trece años atrás, Marylin desapareció. Durante todo este tiempo Jon estuvo convencido de que seguía viva. Hoy ha vuelto a Blackwood.", function () {
            Asylum.showScene("s1-exterior");
        });
    }

    async function s1Approach() {
        await Asylum.markScene("sala1_exterior");
        Asylum.showScene("s1-code");
    }

    function s1EnterCode() {
        Asylum.showBlackScreen("La entrada está sellada. Necesito recordar el código.", "Código", async function (value, error) {
            if (value !== "1888" && value !== "0018") {
                error("El código no parece correcto.");
                return;
            }

            await Asylum.saveProgress("sala1_codigo", value);
            Asylum.closeBlackScreen();
            Asylum.showScene("s1-door");
        });
    }

    async function s1Enter() {
        await Asylum.markScene("sala1_completada");
        Asylum.navigateToRoom(2);
    }
</script>
