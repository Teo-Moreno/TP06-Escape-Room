@{
    ViewData["Title"] = "Habitación 3";
    int idPartida = ViewBag.IdPartida != null ? (int)ViewBag.IdPartida : 0;
}

<div class="asylum-room" data-room="3" data-partida="@idPartida">
    <div class="asylum-stage">

        <section id="s3-hall" class="asylum-scene active scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 3/12.png" alt="Pasillo principal" />
            <div class="scene-caption">El pasillo parece no terminar nunca.</div>
            <button class="hotspot position-center" type="button" onclick="s3Advance()">AVANZAR</button>
        </section>

        <section id="s3-shadow" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 3/16.png" alt="Silueta al fondo del pasillo" />
        </section>

        <section id="s3-chair" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 3/14.png" alt="Habitación con una chica sentada" />
            <button class="hotspot position-center" type="button" onclick="s3Girl()">ACERCARME</button>
        </section>

        <section id="s3-empty" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 3/15.png" alt="Habitación vacía" />
            <div class="scene-caption">La habitación está vacía.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s3LeaveEmpty()">SALIR</button>
        </section>

        <section id="s3-doorway" class="asylum-scene scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 3/17.png" alt="Pasillo hacia una puerta abierta" />
            <div class="scene-caption">Al fondo hay una puerta abierta.</div>
            <button class="hotspot position-center" type="button" onclick="s3EnterDoor()">ENTRAR</button>
        </section>

    </div>
</div>

@await Html.PartialAsync("_Overlays")

<script>
    async function s3Advance() {
        await Asylum.markScene("sala3_pasillo");
        Asylum.showScene("s3-shadow");
        setTimeout(function () {
            Asylum.showScene("s3-chair");
        }, 900);
    }

    async function s3Girl() {
        await Asylum.markScene("sala3_ilusion_chica");
        Asylum.showText("Jon...", function () {
            Asylum.flashBlack(450);
            Asylum.showText("Marylin...", function () {
                Asylum.showScene("s3-empty");
            });
        });
    }

    async function s3LeaveEmpty() {
        await Asylum.markScene("sala3_habitacion_vacia");
        Asylum.showScene("s3-doorway");
    }

    async function s3EnterDoor() {
        await Asylum.markScene("sala3_puerta");
        Asylum.playScream();
        Asylum.flashBlack(1800);
        setTimeout(function () {
            Asylum.navigateToRoom(4);
        }, 1800);
    }
</script>
