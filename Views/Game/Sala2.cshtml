@{
    ViewData["Title"] = "Habitación 2";
    int idPartida = ViewBag.IdPartida != null ? (int)ViewBag.IdPartida : 0;
}

<div class="asylum-room" data-room="2" data-partida="@idPartida">
    <div class="asylum-stage">

        <section id="s2-reception" class="asylum-scene active scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/5.png" alt="Recepción abandonada" />
            <div class="scene-caption">Papeles rotos, basura y un mostrador cubierto de polvo.</div>
            <button class="hotspot position-top-right" type="button" onclick="s2Computer()">COMPUTADORA</button>
            <button class="hotspot position-bottom-left" type="button" onclick="s2Files()">ARCHIVADORES</button>
        </section>

        <section id="s2-error" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/6.png" alt="Computadora con error" />
            <div class="scene-caption">La computadora muestra un error. Se escucha un ruido detrás de Jon.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s2Files()">ALEJARME</button>
        </section>

        <section id="s2-files" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/7.png" alt="Sala de archivadores" />
            <button class="hotspot position-top-left" type="button" onclick="s2Marylin()">EXPEDIENTE</button>
            <button class="hotspot position-top-right" type="button" onclick="s2Jon()">OTRO EXPEDIENTE</button>
            <button class="hotspot position-bottom-right" type="button" onclick="s2Unavailable()">COMPUTADORA</button>
        </section>

        <section id="s2-marylin" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/8.png" alt="Expediente de Marylin" />
            <div class="scene-caption">MARYLIN CROSE — DESAPARECIDA: 17/04/2013</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s2Files()">VOLVER</button>
        </section>

        <section id="s2-jon" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/11.png" alt="Expediente de Jon" />
            <div class="scene-caption">JON HERMENDOFF. El expediente no debería existir.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s2Files()">VOLVER</button>
        </section>

        <section id="s2-unavailable" class="asylum-scene scene-dark">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/9.png" alt="Archivo no disponible" />
            <div class="scene-caption">ARCHIVO NO DISPONIBLE</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s2Corpse()">SEGUIR</button>
        </section>

        <section id="s2-corpse" class="asylum-scene scene-dark scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 2/10.png" alt="Cadáver en la recepción" />
            <div class="scene-caption">El cadáver parece moverse. Entonces habla.</div>
            <button class="hotspot position-center" type="button" onclick="s2CorpseTalk()">ESCUCHAR</button>
        </section>

    </div>
</div>

@await Html.PartialAsync("_Overlays")

<script>
    async function s2Computer() {
        await Asylum.markScene("sala2_computadora");
        Asylum.playNoise(.35, .08);
        Asylum.showScene("s2-error");
    }

    async function s2Files() {
        await Asylum.markScene("sala2_archivos");
        Asylum.showScene("s2-files");
    }

    async function s2Marylin() {
        await Asylum.markScene("sala2_marylin");
        Asylum.showScene("s2-marylin");
    }

    async function s2Jon() {
        await Asylum.markScene("sala2_jon");
        Asylum.showScene("s2-jon");
    }

    async function s2Unavailable() {
        await Asylum.markScene("sala2_archivo_no_disponible");
        Asylum.playNoise(.25, .07);
        Asylum.showScene("s2-unavailable");
    }

    async function s2Corpse() {
        await Asylum.markScene("sala2_cadaver");
        Asylum.showScene("s2-corpse");
    }

    async function s2CorpseTalk() {
        await Asylum.markScene("sala2_cadaver_habla");
        Asylum.showText("Recuerda, no te dejes ganar. Recuerda los sucesos.", function () {
            Asylum.showBlackScreen("Para avanzar primero debo recordar cuál era la fecha de desaparición de Marylin.", "DD/MM/AAAA", async function (value, error) {
                if (value !== "17/04/2013") {
                    error("Esa no es la fecha que Jon recuerda.");
                    return;
                }

                await Asylum.saveProgress("fecha_marylin", value);
                Asylum.closeBlackScreen();
                Asylum.showText("La fecha vuelve a su mente. Jon puede continuar.", function () {
                    Asylum.navigateToRoom(3);
                });
            });
        });
    }
</script>
