@{
    ViewBag.Title = "Sala 4";
}

<div class="game-room" id="gameRoom" data-room="4">

    <img class="room-background"
         src="../../wwwroot/images/salas/sala4.png"
         alt="Habitación de pacientes">

    <button class="game-button"
            onclick="room4Camilla(1)"
            style="left: 25%; top: 60%;">
        Camilla
    </button>

    <button class="game-button"
            onclick="room4Camilla(2)"
            style="left: 48%; top: 58%;">
        Camilla
    </button>

    <button class="game-button"
            onclick="room4Camilla(3)"
            style="left: 68%; top: 60%;">
        Camilla
    </button>

    <button class="game-button"
            onclick="room4Puerta()"
            style="left: 52%; top: 25%;">
        Puerta
    </button>

</div>

<div id="gameModal" class="game-modal hidden">
    <div class="game-modal-content">
        <button class="close-modal" onclick="cerrarModal()">X</button>
        <div id="modalContent"></div>
    </div>
</div>

<div id="notification" class="game-notification"></div>