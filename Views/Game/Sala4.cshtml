@{
    ViewData["Title"] = "Habitación 4";
    int idPartida = ViewBag.IdPartida != null ? (int)ViewBag.IdPartida : 0;
}

<div class="asylum-room" data-room="4" data-partida="@idPartida">
    <div class="asylum-stage">

        <section id="s4-patients" class="asylum-scene active scene-darker scene-vignette">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 4/18.png" alt="Sala de pacientes" />
            <div class="scene-caption">Camillas vacías. Una de ellas tiene un paciente.</div>
            <button class="hotspot position-center" type="button" onclick="s4Patient()">ACERCARME</button>
        </section>

        <section id="s4-patient" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 4/19.png" alt="Paciente en una camilla" />
            <div class="scene-caption">La llave está junto a la camilla.</div>
            <button class="hotspot position-bottom-right" type="button" onclick="s4TakeKey()">AGARRAR LLAVE</button>
        </section>

        <section id="s4-key" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 4/20.png" alt="Llave en el suelo" />
            <div class="scene-caption">Jon toma la llave.</div>
            <button class="hotspot position-center" type="button" onclick="s4Leave()">CONTINUAR</button>
        </section>

        <section id="s4-jon" class="asylum-scene scene-darker">
            <img class="asylum-scene-image" src="../../wwwroot/img/Habitacion 4/21.png" alt="Jon en el hospital" />
            <div class="scene-caption">Algo detrás de él cae al suelo. Jon respira con dificultad.</div>
            <button class="hotspot position-center" type="button" onclick="s4BonePuzzle()">SEGUIR</button>
        </section>

    </div>
</div>

@await Html.PartialAsync("_Overlays")

<script>
    async function s4Patient() {
        await Asylum.markScene("sala4_paciente");
        Asylum.showScene("s4-patient");
    }

    async function s4TakeKey() {
        await Asylum.markScene("sala4_llave");
        Asylum.playNoise(.45, .09);
        Asylum.flashBlack(180);
        Asylum.showScene("s4-key");
    }

    async function s4Leave() {
        await Asylum.saveProgress("llave_sotano", "1");
        Asylum.showScene("s4-jon");
    }

    function s4BonePuzzle() {
        Asylum.showBlackScreen("Los huesos del ser humano son...... exquisitos", "Cantidad de huesos", async function (value, error) {
            if (value !== "206") {
                error("No. Jon no recuerda esa cantidad.");
                return;
            }

            await Asylum.saveProgress("huesos_humanos", value);
            Asylum.closeBlackScreen();
            Asylum.showText("206. La respuesta abre el paso hacia las escaleras.", function () {
                Asylum.navigateToRoom(5);
            });
        });
    }
</script>
