@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page page--center">
    <div class="panel">
        <h1 class="page-title">ERROR</h1>
        <p class="muted">Algo salió mal mientras se procesaba tu pedido.</p>

        @if (Model.ShowRequestId)
        {
            <p class="muted small">Código: <code>@Model.RequestId</code></p>
        }

        <a class="btn" href="@Url.Action("Index", "Home")">VOLVER AL INICIO</a>
    </div>
</div>
