<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Asylum</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    string? nombreJugador = Context.Session.GetString("Nombre");
}
<body class="@ViewData["BodyClass"]">
    <header class="site-header">
        <a class="site-brand" href="@Url.Action("Index", "Home")">THE ASYLUM</a>
        <nav class="site-nav">
            <a class="header-btn" href="@Url.Action("Index", "Home")">Inicio</a>
            <a class="header-btn" href="@Url.Action("Saved", "Game")">Partidas</a>
            <a class="header-btn" href="@Url.Action("Credits", "Home")">Créditos</a>
            @if (nombreJugador != null)
            {
                <a class="header-btn header-btn--ghost" href="@Url.Action("Logout", "Home")">Salir (@nombreJugador)</a>
            }
            else
            {
                <a class="header-btn header-btn--ghost" href="@Url.Action("Login", "Home")">Ingresar</a>
            }
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
