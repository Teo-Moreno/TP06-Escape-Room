@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="page page--center">
    <div class="panel">
        <h1 class="page-title">INICIAR SESIÓN</h1>

        <form class="form" action="@Url.Action("Login", "Home")" method="post">
            <label class="field">
                <span>Nombre</span>
                <input type="text" name="jugador" autocomplete="username" required />
            </label>

            <label class="field">
                <span>Contraseña</span>
                <input type="password" name="password" autocomplete="current-password" required />
            </label>

            @if (ViewBag.Error != null)
            {
                <p class="form-error">@ViewBag.Error</p>
            }

            <button class="btn btn--primary" type="submit">INGRESAR</button>
        </form>

        <a class="link" href="@Url.Action("Register", "Home")">¿No tenés cuenta? Registrate</a>
    </div>
</div>
