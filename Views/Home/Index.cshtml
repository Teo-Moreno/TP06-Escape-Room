@{
    ViewData["Title"] = "Inicio";
    ViewData["BodyClass"] = "home-body";
    bool logueado = Context.Session.GetInt32("IdJugador") != null;
}

<div class="home">
    <img class="home-bg" src="~/img/Habitacion 1/2.png" alt="" />

    <div class="home-content">
        <p class="home-kicker">BLACKWOOD PSYCHIATRIC HOSPITAL · EST. 1888</p>
        <h1 class="home-title">THE ASYLUM</h1>

        <div class="home-intro">
            <p>17/04/2013 — Marylin Crose desapareció.</p>
            <p>Trece años después, Jon Hermendoff vuelve al lugar donde la vieron por última vez.</p>
        </div>

        <div class="home-menu">
            @if (logueado)
            {
                <a class="btn btn--primary" href="@Url.Action("Saved", "Game")">JUGAR</a>
            }
            else
            {
                <a class="btn btn--primary" href="@Url.Action("Login", "Home")">COMENZAR</a>
                <a class="btn" href="@Url.Action("Register", "Home")">REGISTRARSE</a>
            }
            <a class="btn" href="@Url.Action("Credits", "Home")">CRÉDITOS</a>
        </div>
    </div>
</div>
