@{
    ViewData["Title"] = "Home Page";
}

<div class="home">

    <section class="hero">
        <div class="overlay"></div>

        <div class="hero-content">
            <p class="subtitle">BLACKWOOD PSYCHIATRIC HOSPITAL</p>

            <h1>THE ASYLUM</h1>

            <p class="description">
                Un hospital abandonado.<br>
                Una mujer desaparecida.<br>
                Y una verdad que nunca debió ser recordada.
            </p>

            <a class="start-btn" href="@Url.Action("NewGame", "Game")">
                COMENZAR
            </a>
        </div>
    </section>

    <section class="intro">
        <h2>13 años después...</h2>

        <p>
            Jon Hermendoff regresa al antiguo Blackwood Psychiatric Hospital
            buscando respuestas sobre la desaparición de su esposa.
        </p>

        <p>
            Pero algunas cosas que fueron olvidadas
            prefieren permanecer así.
        </p>
    </section>

</div>