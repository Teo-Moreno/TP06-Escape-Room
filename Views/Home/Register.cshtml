@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="page page--center">
    <div class="panel">
        <h1 class="page-title">CREAR CUENTA</h1>

        <form class="form" action="@Url.Action("Register", "Home")" method="post">
            <label class="field">
                <span>Nombre</span>
                <input type="text" name="nombre" maxlength="50" autocomplete="username" required />
            </label>

            <label class="field">
                <span>Contraseña</span>
                <input type="password" name="password" autocomplete="new-password" required />
            </label>

            <label class="field">
                <span>Repetir contraseña</span>
                <input type="password" name="password2" autocomplete="new-password" required />
            </label>

            @if (ViewBag.Error != null)
            {
                <p class="form-error">@ViewBag.Error</p>
            }

            <button class="btn btn--primary" type="submit">CREAR CUENTA</button>
        </form>

        <a class="link" href="@Url.Action("Login", "Home")">Ya tengo una cuenta</a>
    </div>
</div>
